{
  "name": "markdown-note-taker",
  "version": "1.0.0",
  "description": "A local single-user note workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @markdown-note-taker/shared && concurrently --kill-others --names shared,server,web \"npm run dev -w @markdown-note-taker/shared\" \"npm run dev -w @markdown-note-taker/server\" \"npm run dev -w @markdown-note-taker/web\"",
    "typecheck": "npm run build -w @markdown-note-taker/shared && npm run typecheck --workspaces && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build -w @markdown-note-taker/shared && npm run build -w @markdown-note-taker/server && npm run build -w @markdown-note-taker/web",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env apps/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
